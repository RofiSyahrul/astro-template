{
  "name": "astro-template",
  "type": "module",
  "version": "0.0.1",
  "description": "A starter kit using Astro with Svelte, Tailwind, complete linter setup, complete SEO setup and service worker",
  "scripts": {
    "astro": "astro",
    "build": "pnpm sync-and-check && astro build",
    "build:sw": "pnpm sync-and-check && SW_ENABLED=true astro build",
    "build:vercel": "pnpm sync-and-check && DEPLOYMENT_PLATFORM=vercel astro build",
    "dev": "astro sync && DEV_TOOLBAR=true astro dev",
    "dev:no-toolbar": "astro sync && astro dev",
    "lint": "pnpm run \"/^lint:/\"",
    "lint:code": "eslint . --ext .astro,.svelte,.ts,.tsx,.js,.jsx",
    "lint:style": "stylelint '**/*.{css,scss,sass,less,astro,svelte}'",
    "prepare": "husky",
    "preview": "astro preview",
    "preview:sw": "astro preview --port 9999 --host",
    "release": "standard-version",
    "sync-and-check": "astro sync && astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/node": "^9.5.1",
    "@astrojs/svelte": "^7.2.3",
    "@astrojs/vercel": "^9.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/og": "^0.8.5",
    "astro": "^5.16.5",
    "astrojs-service-worker": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "ua-parser-js": "^2.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/eslint": "^9.6.1",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "autoprefixer": "^10.4.20",
    "commitizen": "^4.3.1",
    "cssnano": "^7.0.6",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-alias": "^1.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-svelte": "^3.13.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "postcss-html": "^1.7.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.0",
    "sass": "^1.80.6",
    "standard-version": "^9.5.0",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "svelte": "^5.46.0",
    "svelte-eslint-parser": "^1.4.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,svelte,astro}": [
      "eslint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
